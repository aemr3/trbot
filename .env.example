DATABASE_URL=./data/db.sqlite
TRBOT_USERNAME=
TRBOT_PASSWORD=

# Market data feed account. Required: every price, candle, order book and broker
# reading comes from it, and the server refuses to start without it.
FINTABLES_USERNAME=
FINTABLES_PASSWORD=

TRBOT_SERVER_HOST=127.0.0.1
TRBOT_SERVER_PORT=7717
TRBOT_SERVER_URL=http://127.0.0.1:7717

# Generate with: bun run server:token
TRBOT_SERVER_TOKEN=example-token-replace-before-use

# Optional. Create a private bot with @BotFather to use /connect in chat.
TRBOT_TELEGRAM_BOT_TOKEN=

# Optional. Emits aggregated performance summaries every 10 seconds from the
# server console and the terminal's Logs tab. No per-tick data is logged.
TRBOT_PERFORMANCE=false

# Optional overrides. A non-loopback server defaults to data/tls/server.crt,
# data/tls/server.key, and data/tls/ca.crt.
# TRBOT_SERVER_TLS_CERT=
# TRBOT_SERVER_TLS_KEY=
# TRBOT_SERVER_TLS_CLIENT_CA=

# Optional overrides. An HTTPS client defaults to data/tls/ca.crt, client.crt,
# and client.key; setting only TRBOT_CLIENT_TLS_SERVER_CA uses its sibling client files.
# TRBOT_CLIENT_TLS_SERVER_CA=
# TRBOT_CLIENT_TLS_CERT=
# TRBOT_CLIENT_TLS_KEY=
