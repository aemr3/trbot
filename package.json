{
  "name": "trbot",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "dev": "bun --watch run src/index.ts",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "start": "bun run src/index.ts",
    "test": "bun test --path-ignore-patterns='tmp/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@opentui/core": "^0.5.1",
    "ai": "^7.0.58",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  }
}
