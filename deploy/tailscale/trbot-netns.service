[Unit]
Description=trbot isolated network namespace
Wants=network-online.target
After=network-online.target
Before=trbot-tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/trbot-netns start
ExecStop=/usr/local/libexec/trbot-netns stop

[Install]
WantedBy=multi-user.target
