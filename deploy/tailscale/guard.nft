table inet trbot_ts_guard {
  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state established,related accept
    iifname "tailscale0" accept

    # The isolated daemon needs its WireGuard transport over the bootstrap veth.
    iifname "trbot-net" udp dport 41641 accept
  }

  chain output {
    type filter hook output priority filter; policy drop;

    oifname "lo" accept
    ct state established,related accept
    oifname "tailscale0" accept

    # Internet traffic leaves through the VPS when no Tailscale exit node is selected.
    oifname "trbot-net" accept
  }
}
