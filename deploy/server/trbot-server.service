[Unit]
Description=trbot server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trbot
Group=trbot
WorkingDirectory=/home/trbot/current
Environment=HOME=/home/trbot
EnvironmentFile=/home/trbot/shared/server.env
ExecStartPre=/home/linuxbrew/.linuxbrew/bin/bun run server:cert 127.0.0.1 localhost $TRBOT_SERVER_TLS_HOSTS
ExecStartPre=/home/linuxbrew/.linuxbrew/bin/bun run db:migrate
ExecStart=/home/linuxbrew/.linuxbrew/bin/bun run server
ExecStartPost=/home/trbot/bin/healthcheck
Restart=always
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/trbot/shared /home/trbot/.cache

[Install]
WantedBy=multi-user.target
