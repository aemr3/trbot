[Unit]
Description=trbot server
Requires=trbot-netns.service trbot-tailscaled.service
After=trbot-netns.service trbot-tailscaled.service

[Service]
Type=simple
User=trbot
Group=trbot
WorkingDirectory=/home/trbot/current
Environment=HOME=/home/trbot
EnvironmentFile=/home/trbot/shared/server.env
NetworkNamespacePath=/run/netns/trbot
ExecStartPre=/home/linuxbrew/.linuxbrew/bin/bun run server:cert 127.0.0.1 trbot.tailb47e39.ts.net 100.83.199.91
ExecStartPre=/home/linuxbrew/.linuxbrew/bin/bun run db:migrate
ExecStart=/home/linuxbrew/.linuxbrew/bin/bun run server
ExecStartPost=/home/trbot/bin/healthcheck
Restart=always
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/trbot/shared /home/trbot/.cache

[Install]
WantedBy=multi-user.target
